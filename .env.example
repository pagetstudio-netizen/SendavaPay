# ============================================================
# Variables d'environnement requises pour Plesk (production)
# Copiez ce fichier en .env et renseignez vos valeurs
# ============================================================

# OBLIGATOIRE - Base de données PostgreSQL (Supabase)
SUPABASE_DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# OBLIGATOIRE - Clé secrète pour les sessions utilisateur (chaine aléatoire longue)
SESSION_SECRET=changez-cette-valeur-en-une-chaine-aleatoire-longue

# OBLIGATOIRE - Mode de l'application
NODE_ENV=production

# OBLIGATOIRE - Port d'écoute (Plesk gère cela automatiquement souvent)
PORT=3000

# OPTIONNEL - URL Supabase (pour le stockage KYC)
SUPABASE_URL=https://[PROJECT].supabase.co

# OPTIONNEL - Clé API Resend pour l'envoi d'emails (obtenez-la sur resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@votredomaine.com

# ============================================================
# Les clés des passerelles de paiement sont gérées depuis
# le panneau admin de SendavaPay (section "Clés API")
# et stockées en base de données - pas besoin de les mettre ici.
# ============================================================
