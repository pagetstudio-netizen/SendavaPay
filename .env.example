# ============================================================
#  SendavaPay — Variables d'environnement pour Plesk / prod
#  Copiez ce fichier en .env et remplissez les valeurs
# ============================================================

# ── OBLIGATOIRES ─────────────────────────────────────────────
# URL de connexion PostgreSQL Supabase
SUPABASE_DATABASE_URL=postgresql://postgres.XXXX:MOT_DE_PASSE@aws-1-us-west-2.pooler.supabase.com:5432/postgres

# Secret de session (générez avec: openssl rand -base64 48)
SESSION_SECRET=changez_moi_avec_une_longue_chaine_aleatoire

# ── SÉCURITÉ — CHEMIN SECRET DU PANNEAU ADMIN ────────────────
# Remplace /admin par un chemin secret connu de vous seul.
# Générez avec: openssl rand -hex 8   (ex: a3f7c2e91b4d6082)
# Sans cette variable, le panneau reste accessible à /admin (dev uniquement).
# IMPORTANT: ne jamais utiliser "admin" comme valeur.
ADMIN_SECRET_PATH=votre-chemin-secret-ici

# Environnement
NODE_ENV=production

# Port d'écoute (Plesk le définit souvent automatiquement)
PORT=5000

# ── EMAIL NOTIFICATIONS (Resend) ─────────────────────────────
# Utilisé pour : dépôt, retrait, KYC, transfert, broadcast admin
# Clé API Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Adresse d'expédition vérifiée dans Resend
RESEND_FROM_EMAIL=noreply@sendavapay.com

# ── EMAIL OTP / TRANSACTIONNEL (Brevo) ───────────────────────
# Utilisé pour : inscription, nouvel appareil, réinitialisation mot de passe
# Clé API Brevo (https://app.brevo.com → SMTP & API → Clés API)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxx
# Adresse d'expédition vérifiée dans Brevo (optionnel, sinon utilise RESEND_FROM_EMAIL)
BREVO_FROM_EMAIL=noreply@sendavapay.com
# Nom d'expéditeur affiché (optionnel, défaut: SendavaPay)
BREVO_FROM_NAME=SendavaPay

# ── SUPABASE PRINCIPAL (base de données + stockage KYC fallback) ─
# URL de votre projet Supabase (ex: https://abcd1234.supabase.co)
SUPABASE_URL=https://VOTRE_ID.supabase.co
# La clé Service Role est configurable via le panneau admin SendavaPay
# (section Clés API → SUPABASE_SERVICE_ROLE_KEY) — pas besoin de l'ajouter ici

# ── SUPABASE KYC (compte dédié au stockage des documents KYC) ──
# Optionnel. Si renseigné, les photos CNI/passeport/selfie sont stockées dans
# CE compte Supabase, séparément de la base de données principale.
# Permet de contourner le quota de stockage du compte principal.
# Configurez également ces valeurs dans le panneau admin (section Clés API).
# SUPABASE_KYC_URL=https://VOTRE_KYC_ID.supabase.co
# SUPABASE_KYC_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...

# ── PASSERELLES DE PAIEMENT ───────────────────────────────────
# Ces clés sont configurables directement dans le panneau admin SendavaPay
# (section Clés API). Vous pouvez aussi les définir ici si vous préférez.
# SOLEASPAY_API_KEY=
# SOLEASPAY_SECRET_KEY=
# OMNIPAY_API_KEY=
# OMNIPAY_CALLBACK_KEY=
# MAISHAPAY_PUBLIC_KEY=
# MAISHAPAY_SECRET_KEY=
# PAXITY_API_KEY=
# MBIYOPAY_API_KEY=
# MbiyoPay ne documente pas de signature webhook : les callbacks sont vérifiés
# côté serveur en consultant la transaction avec MBIYOPAY_API_KEY.
# Secret HMAC pour le webhook MaishaPay (signature SHA-256 du corps brut)
# MAISHAPAY_WEBHOOK_SECRET=
# Secret HMAC pour le webhook Paxity (signature SHA-256 du corps brut)
# PAXITY_WEBHOOK_SECRET=
# Clé de vérification de signature OmniPay (obligatoire pour traiter les callbacks)
# OMNIPAY_CALLBACK_KEY=

# ── NOTIFICATIONS TELEGRAM (optionnel) ────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Secret défini aussi dans la configuration webhook Telegram.
# TELEGRAM_WEBHOOK_SECRET=
# IDs Telegram autorisés à exécuter les actions administratives (séparés par des virgules).
# TELEGRAM_ADMIN_CHAT_IDS=
